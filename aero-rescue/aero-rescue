#!/usr/bin/env bash
set -euo pipefail

case "${1:-}" in
  -on)
    echo "Aero Rescue: temporäre Rescue-Konsole"
    echo "Diagnosefunktionen werden in einer späteren Version ergänzt."
    ;;
  -full)
    echo "Aero Rescue: vollständiger Rescue-Boot wird vorbereitet."
    echo "Unabhängige Rescue-Umgebung ist noch nicht implementiert."
    ;;
  --version|-v)
    echo "Aero Rescue 0.1.0-dev"
    ;;
  *)
    echo "Verwendung: aero rescue -on | -full"
    exit 1
    ;;
esac
