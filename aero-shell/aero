#!/usr/bin/env bash
# Aero Shell – frühes Entwicklungsgrundgerüst
# Ziel: schneller Aero-Zugriff auf normale Linux-Funktionen.
set -euo pipefail

AERO_VERSION="0.1.0-dev"

case "${1:-}" in
  --version|-v)
    echo "Aero Shell ${AERO_VERSION}"
    ;;
  update)
    exec "$(dirname "$0")/../aero-update/aero-update" update
    ;;
  rescue)
    exec "$(dirname "$0")/../aero-rescue/aero-rescue" "${@:2}"
    ;;
  search)
    shift
    if command -v xdg-open >/dev/null 2>&1; then
      xdg-open "https://duckduckgo.com/?q=$(printf '%s' "$*" | sed 's/ /+/g')" >/dev/null 2>&1 &
    else
      echo "Suche: $*"
    fi
    ;;
  web)
    shift
    command -v xdg-open >/dev/null 2>&1 && xdg-open "$1" >/dev/null 2>&1 &
    ;;
  download)
    shift
    command -v curl >/dev/null 2>&1 || { echo "curl ist nicht installiert."; exit 1; }
    curl -LO "$1"
    ;;
  *)
    exec zsh -l
    ;;
esac
