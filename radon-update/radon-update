#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"

case "${1:-}" in
  update)
    echo "Radon Update"
    echo "Aktualisiere Linux Mint und die Radon-Komponenten."
    if command -v sudo >/dev/null 2>&1 && command -v apt >/dev/null 2>&1; then
      sudo apt update
      sudo apt upgrade -y
    else
      echo "apt/sudo nicht verfügbar – Entwicklungsumgebung erkannt."
    fi
    if command -v git >/dev/null 2>&1 && git -C "$ROOT" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
      echo "Aktualisiere Radon-Quellen …"
      git -C "$ROOT" pull --ff-only || echo "Radon-Quellen konnten nicht automatisch aktualisiert werden."
    fi
    ;;
  --version|-v) echo "Radon Update $(cat "$ROOT/VERSION")" ;;
  *) echo "Verwendung: radon update"; exit 1 ;;
esac
