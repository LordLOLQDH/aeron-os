#!/usr/bin/env bash
set -euo pipefail

case "${1:-}" in
  update)
    echo "Aero Update"
    echo ""
    echo "Aktualisiere Arch Linux und Aero-Komponenten in einem Ablauf."
    if command -v sudo >/dev/null 2>&1 && command -v pacman >/dev/null 2>&1; then
      sudo pacman -Syu
    else
      echo "pacman/sudo nicht verfügbar – Entwicklungsumgebung erkannt."
    fi
    ;;
  --version|-v)
    echo "Aero Update 0.1.0-dev"
    ;;
  *)
    echo "Verwendung: aero update"
    exit 1
    ;;
esac
